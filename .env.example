# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Crawler ---
CRAWL_START_URL=https://khi.au.edu.pk/
CRAWL_ALLOWED_DOMAINS=au.edu.pk,www.au.edu.pk,khi.au.edu.pk,khiportals.au.edu.pk,webdata.au.edu.pk,portals.au.edu.pk,admissions.au.edu.pk,admission.au.edu.pk,kc.au.edu.pk,multan.au.edu.pk,kamra.au.edu.pk,aack.au.edu.pk
CRAWL_MAX_PAGES=40
CRAWL_MAX_DEPTH=3
CRAWL_CONCURRENCY=2
CRAWL_DELAY_MS=750
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_RETRIES=2
CRAWL_MAX_DOCUMENT_MB=15
CRAWL_RESPECT_ROBOTS=true
CRAWL_FOLLOW_PDFS=true
CRAWL_FOLLOW_IMAGES=false
# CRAWL_USER_AGENT=AU-KnowledgeBot/1.0 (contact: you@yourdomain)

# --- Retrieval / embeddings ---
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_CONFIDENCE=0.3
RETRIEVAL_CHUNK_SIZE=1100
RETRIEVAL_CHUNK_OVERLAP=180
RETRIEVAL_STALE_DAYS=30
RETRIEVAL_KEYWORD_WEIGHT=0.55
RETRIEVAL_VECTOR_WEIGHT=0.45
# hash = offline CPU model; ollama = local embedding server
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-ngram-384

# --- Language model (no paid API needed for local mode) ---
# extractive | ollama | lmstudio | hosted
LLM_PROVIDER=extractive
LLM_MODEL=grounded-extractive-v1
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=700
LLM_TIMEOUT_MS=60000
LLM_CONTEXT_CHUNKS=6
LLM_STREAMING=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
HOSTED_LLM_BASE_URL=https://api.openai.com/v1
# Hosted keys are read server-side only — never exposed to the browser:
# HOSTED_LLM_API_KEY=
# LM_STUDIO_API_KEY=

# --- Image understanding (optional; voice features need no API key) ---
# VLM_BASE_URL=https://api.openai.com/v1
# VLM_MODEL=gpt-4o-mini
# VLM_API_KEY=

# --- Administration & scheduling ---
# CHANGE THIS before deploying:
ADMIN_PASSWORD=au-knowledge-admin
# ADMIN_SESSION_SECRET=
# CRON_SECRET=
# OCR_SERVICE_URL=
